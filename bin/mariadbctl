#!/bin/bash

SERVICE="mariadb.service"

# Parse arguments
case "$1" in
    start)
        echo "Starting mariadb service..."
        systemctl start "$SERVICE"
        ;;
    stop)
        echo "Stop mariadb service..."
        systemctl stop "$SERVICE"
        ;;
    *)
        echo "Usage: $0 {serve||model|controller|migration}"
        exit 1
        ;;
esac
