#!/bin/bash

# ========================================
# Multi-Project Development Script
# ========================================
# Usage:
#   devctl laravel
#
# Currently supports:
#   - laravel
#
# ========================================

# Show help message
show_usage() {
    echo "Usage: $0 {laravel}"
    echo
    echo "Examples:"
    echo "  $0 laravel   # Start Laravel app with MariaDB, PHP, and Vite"
    echo "  $0 node      # Start Node.js app (example placeholder)"
    echo "  $0 react     # Start React app (example placeholder)"
    echo
    exit 1
}

# Check if at least 1 argument is provided
if [ -z "$1" ]; then
    echo "Error: No parameter provided."
    show_usage
fi

# Capture the first argument as the project type
PROJECT_TYPE="$1"

# ========================================
# Helper Functions
# ========================================

# Check and start MariaDB
start_mariadb_if_needed() {
    echo "Checking MariaDB status..."
    if ! systemctl is-active --quiet mariadb; then
        echo "MariaDB is not running. Starting MariaDB..."
        sudo systemctl start mariadb
        echo "MariaDB started."
    else
        echo "MariaDB is already running."
    fi
}

# Run processes and track their PIDs
run_background_process() {
    "$@" &
    echo "$!"
}

# Trap Ctrl+C to stop all background processes
cleanup() {
    echo -e "\nStopping all processes..."
    for pid in "${PIDS[@]}"; do
        kill "$pid" 2>/dev/null
    done
    echo "All processes stopped."
    exit 0
}

# ========================================
# Main Logic
# ========================================

case "$PROJECT_TYPE" in
    laravel)
        echo "Starting Laravel development environment..."

        # Step 1: Start MariaDB if needed
        start_mariadb_if_needed

        # Step 2: Start Laravel server
        echo "Starting Laravel server (php artisan serve)..."
        PHP_PID=$(run_background_process php artisan serve)
        PIDS+=("$PHP_PID")

        # Step 3: Start Vite (npm run dev)
        echo "Starting Vite (npm run dev)..."
        NPM_PID=$(run_background_process npm run dev)
        PIDS+=("$NPM_PID")

        echo "Laravel and Vite are running!"
        echo "Laravel PID: $PHP_PID, Vite PID: $NPM_PID"
        echo "Press Ctrl+C to stop everything."
        trap cleanup SIGINT

        # Keep script alive until background processes stop
        wait
        ;;

    *)
        echo "Error: Unknown project type '$PROJECT_TYPE'."
        show_usage
        ;;
esac
