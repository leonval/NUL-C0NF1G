[global]
# display
origin = top-right
frame_width = 2
corner_radius = 8
progress_bar_corner_radius = 5
offset = (20, 50)
gap_size = 5
fullscreen = delay

# color
frame_color = "#04ff04"
separator_color = frame
highlight = "#04ff04"
background = "#000000"
foreground = "#04ff04"

# text
format = "<b>%a</b>\n\n%s\n<i>%b</i>"
font = "Fira Sans 12"
icon_theme = "Papirus-Dark"

# action
mouse_right_click = context, close_current
dmenu = /usr/bin/fuzzel -d

[urgency_low]
foreground = "#ffffff"
frame_color = "#ffffff"
# default_icon = "~/.config/dunst/icons/bell-badge-low.svg"

[urgency_normal]
foreground = "#04ff04"
frame_color = "#04ff04"
# default_icon = "~/.config/dunst/icons/bell-badge.svg"

[urgency_critical]
foreground = "#f38ba8"
frame_color = "#f38ba8"
# default_icon = "~/.config/dunst/icons/alert-decagram.svg"
timeout = 0
