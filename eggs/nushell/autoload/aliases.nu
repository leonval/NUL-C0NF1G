# Basic Unix Navigation
alias ll = ls -la
alias la = ls -a

# Program Aliases
alias lg = lazygit
alias vim = nvim

# yolk dotfiles
alias ygs = yolk git status
alias ygl = yolk git log
alias ygaa = yolk git add -A
alias ygc = yolk git commit
alias ygp = yolk git push
alias ygf = yolk git fetch
alias ygP = yolk git pull
