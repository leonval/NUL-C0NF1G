{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)

    "modules-left": ["custom/launcher", "niri/workspaces", "wlr/taskbar"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "group/connection", "pulseaudio", "battery"],

    "custom/launcher":{
        "format": "🞊",
        "on-click": "fuzzel",
        "on-click-right": "thunar",
        "tooltip": true,
        "tooltip-format": "Left Click: Launch App\nRight Click: File Manager"
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "PRIMUS",
            "2": "SECUNDUS",
            "3": "TERTIUS",
            "4": "QUARTUS",
            "5": "QUINTUS",
            // "urgent": "",
            // "active": " ",
            // "default": ""
         },
	 "on-scroll-up": "niri msg action focus-workspace-up",
	 "on-scroll-down": "niri msg action focus-workspace-down"
    },

    "wlr/taskbar": {
	"format": "{icon}",
	"icon-size": 18,
	"tooltip-format": "{name}",
	"on-click": "activate",
	"on-click-middle": "close",
	"ignore-list": [
	    "Alacritty"
	],
	"app_ids-mapping": {
	    "firefoxdeveloperedition": "firefox-developer-edition"
	},
	"rewrite": {
	    "Firefox Web Browser": "Firefox",
	    "Foot Server": "Terminal"
	}
    },

    "clock": {
        "tooltip-format": "{calendar}",
        "format-alt": "  {:%A, %d %B %Y}",
        "format": " {:%H:%M   %d/%m/%Y}"
    },

    "tray": {
        "icon-size": 21,
        "spacing": 10
    },

    "group/connection": {
	"orientation": "inherit",
	"drawer": {
	    "transition-duration": 250,
	    "children-class": "not-network",
	    "transition-left-to-right": false
	},
	"modules": [
	    "network",
	    "bluetooth"
	]
    },

    "bluetooth": {
	"controller": "blueman",
	"format": " {status}",
	"format-disabled": " off",
	"on-click": "blueman-manager"
    },

    "network": {
        "interface": "wlp0s20f3",

        "format": "{ifname} {signalStrength}%",
        "format-disconnected": "\udb82\udd2e Disconnected",

        "format-wifi": "  {essid}",
        "tooltip-format": "{signalStrength}%",
        "tooltip-format-wifi": "{essid} {signalStrength}%",
        "tooltip-format-disconnected": "No Connection",
        "on-click": "~/.dotfiles/bin/wifi-picker",
        "on-click-right": "nm-connection-manager"
    },

    "pulseaudio": {
        "scroll-step": 5, // %, can be a float
        "format": "{icon} {volume}%",
	"format-bluetooth": "{icon} {volume}%",
        "format-muted": " mute",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
	"max-volume": 150
    },

    "battery": {
	"interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    }
}
