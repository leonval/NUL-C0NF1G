{
  "auto_update": false,
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "vertical_scroll_margin": 10,
  "base_keymap": "VSCode",
  "icon_theme": "Colored Zed Icons Theme Dark",
  "ui_font_size": 16,
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Tokyo Night"
  },
  "relative_line_numbers": "enabled",
  "format_on_save": "on",
  "formatter": "auto",
  "active_pane_modifiers": {
    "border_size": 2.0
  }
}
