[
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j j": "vim::NormalBefore"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      // Tab Navigation
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePreviousItem"
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      // Find File
      "space space": "file_finder::Toggle",

      // Pane Split
      "space w v": "pane::SplitVertical",
      "space w h": "pane::SplitHorizontal",

      // Pane (Buffer) Save and Close
      "space f s": "workspace::Save",
      "space f S": "workspace::SaveWithoutFormat",
      "space b d": "pane::CloseActiveItem",
      "space b a": "pane::CloseAllItems",
      "space b o": "pane::CloseOtherItems",

      // Pane (Buffer) Navigation
      "space h": "workspace::ActivatePaneLeft",
      "space j": "workspace::ActivatePaneDown",
      "space k": "workspace::ActivatePaneUp",
      "space l": "workspace::ActivatePaneRight",

      "space 1": ["pane::ActivateItem", 0],
      "space 2": ["pane::ActivateItem", 1],
      "space 3": ["pane::ActivateItem", 2],
      "space 4": ["pane::ActivateItem", 3],
      "space 5": ["pane::ActivateItem", 4],
      "space 6": ["pane::ActivateItem", 5],
      "space 7": ["pane::ActivateItem", 6],
      "space 8": ["pane::ActivateItem", 7],
      "space 9": "pane::ActivateLastItem"
    }
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "ctrl-f": "vim::Search",
      "space t t": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "(ProjectPanel && not_editing)",
    "bindings": {
      // Close Project Panel
      "escape": "workspace::ToggleLeftDock",

      // Project Panel Operation
      "r": "project_panel::Rename",
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "d": ["project_panel::Delete", { "skip_prompt": false }]
    }
  },
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      // mini.ai plugin behavior
      "q": "vim::MiniQuotes",
      "b": "vim::MiniBrackets"
    }
  }
]
