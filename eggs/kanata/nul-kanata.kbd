(defcfg
  process-unmapped-keys no
  concurrent-tap-hold yes
)

(defsrc
  1	2	3	4	5	6	7	8	9	0	-	=
  tab							u	i	
  caps						h	j	k	l
  	lalt			spc
)

(deflayer PRIMUS
  _	_	_	_	_	_	_	_	_	_	_	_
  @tab							_	_
  @ectl						_	_	_	_
  	@lalt			@spc
)

(deflayer SECUNDUS
  S-1	S-2	S-3	S-4	S-5	S-6	S-7	S-8	S-9	S-0	S--	S-=
  _							_	_
  caps						_	_	_	_
  	@lalt			_
)

(deflayer TERTIUS
  _	_	_	end	_	_	_	_	_	home	_	_
  _							S-tab	tab
  @ectl						◀	▼	▲	▶
  	@lalt			_
)

;; Variables
(defvar
	medium-timeout 200
	brief-timeout 100
)

;; Aliases
(defalias
	;; tap for esc, hold for left-ctrl
	ectl (tap-hold-press $medium-timeout $medium-timeout esc lctl)
	
	;; tap for tab, hold for second layer
	tab (tap-hold-press $medium-timeout $medium-timeout tab (layer-toggle SECUNDUS))

	;; tap for ctl, double tap for caps
	spc (tap-hold $medium-timeout $medium-timeout spc (layer-toggle TERTIUS))

	;; tap for ctl, double tap for caps
	ctlcap (tap-dance $medium-timeout (lctl caps))
	
	;; Windows Navigation
	lnav (tap-hold $medium-timeout $medium-timeout S-tab (macro home))
	rnav (tap-hold $medium-timeout $medium-timeout tab (macro end))

	;; add timeout to lalt
	lalt (one-shot-release 500 lalt)
)
