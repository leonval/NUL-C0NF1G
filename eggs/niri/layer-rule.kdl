// Put wallpaper inside the overview backdrop.
layer-rule {
    match namespace="wallpaper"
    place-within-backdrop true
}

layer-rule {
    match namespace="waybar"

    block-out-from "screencast"
}

layer-rule {
    match namespace="^launcher$"

	background-effect {
        blur true
    }
}
layer-rule {
    match namespace="notifications"

    block-out-from "screencast"
	background-effect {
        blur true
    }
}
