(defcfg
;; You can set the value below to no if you only use the keys defined in defsrc.
  process-unmapped-keys yes
)

(defsrc
       q w e r t y u i o p
  caps a s d f g h j k l ;
       z x c v b n m , . /
         spc ralt
)

(defvar
  streak-count 3
  streak-time 325
  tap-timeout 200
  hold-timeout 500
  chord-timeout 50
)

;; Aliases
(defalias
	;; tap for esc, hold for left-ctrl
	ectl (tap-hold-press 200 200 esc lctl)
)

(deftemplate charmod (char mod)
  (switch 
    ((key-timing $streak-count less-than $streak-time)) $char break
    () (tap-hold-release-timeout $tap-timeout $hold-timeout $char $mod $char) break
  )
)

(deftemplate charmod-notime (char mod)
  (switch 
    ((key-timing $streak-count less-than $streak-time)) $char break
    () (tap-hold-release $tap-timeout $hold-timeout $char $mod) break
  )
)

(defvirtualkeys
  shift (multi (layer-switch PRIMUS) lsft)
  clear (multi (layer-switch PRIMUS) (on-press release-virtualkey shift))
)

(defchords mtl $chord-timeout
  (w  ) w
  (  e) e
  (w e) esc
)

(defchords mtr $chord-timeout
  (i  ) i
  (  o) o
  (i o) bspc
)

(defchords mbl $chord-timeout
  (x  ) (t! charmod x ralt)
  (  c) c
  (x c) tab
)

(defchords mbr $chord-timeout
  (,  ) ,
  (  .) (t! charmod . ralt)
  (, .) ret
)

(deflayermap (PRIMUS)
  caps @ectl
  w (chord mtl w)
  e (chord mtl e)
  i (chord mtr i)
  o (chord mtr o)
  a (t! charmod-notime a lmet)
  s (t! charmod-notime s lalt)
  d (t! charmod-notime d lsft)
  f (t! charmod-notime f lctl)
  j (t! charmod j rctl)
  k (t! charmod k rsft)
  l (t! charmod l lalt)
  ; (t! charmod ; rmet)
  z (t! charmod z lctl) 
  x (chord mbl x)
  c (chord mbl c)
  v (t! charmod v (layer-while-held TERTIUS))
  m (t! charmod m (layer-while-held TERTIUS))
  , (chord mbr ,)
  . (chord mbr .)
  / (t! charmod / rctl)
  spc (t! charmod-notime spc (multi (layer-switch SECUNDUS) (on-release tap-virtualkey clear)))
  ralt (layer-switch TERTIUS)
)

(deflayermap (SECUNDUS)
  caps @ectl
  e (layer-switch TERTIUS)
  r (on-press press-virtualkey shift)
  y ins
  u home
  i up
  o end
  p pgup
  a lmet
  s lalt
  d lsft
  f lctl
  g comp ;; Enable if not MacOS.
  h esc
  j left
  k down
  l rght
  ; pgdn
  z mute
  x vold
  c volu
  v pp
  n tab
  m bspc
  , spc
  . del
  / ret
)

(defchords ftl $chord-timeout
  (w  ) 2
  (  e) 3
  (w e) esc
)

(defchords ftr $chord-timeout
  (i  ) 8
  (  o) 9
  (i o) bspc
)

(defchords fbl $chord-timeout
  (x  ) (t! charmod ` ralt)
  (  c) -
  (x c) tab
)

(defchords fbr $chord-timeout
  (,  ) [
  (  .) (t! charmod ] ralt)
  (, .) ret
)

(deflayermap (TERTIUS)
  caps @ectl
  q 1
  w (chord ftl w)
  e (chord ftl e)
  r 4
  t 5
  y 6
  u 7
  i (chord ftr i)
  o (chord ftr o)
  p 0
  a (t! charmod-notime f1 lmet)
  s (t! charmod-notime f2 lalt)
  d (t! charmod-notime f3 lsft)
  f (t! charmod-notime f4 lctl)
  g f5
  h f6
  j (t! charmod f7 rctl)
  k (t! charmod f8 rsft)
  l (t! charmod f9 lalt)
  ; (t! charmod f10 rmet)
  z (t! charmod lsgt lctl)
  x (chord fbl x)
  c (chord fbl c)
  v =
  b f11
  n f12
  m '
  , (chord fbr ,)
  . (chord fbr .)
  / (t! charmod \ lctl)
  ralt (layer-switch PRIMUS)
)
