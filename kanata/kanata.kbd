(defcfg
  process-unmapped-keys no
  concurrent-tap-hold yes
)

(defsrc
  1	2	3	4	5	6	7	8	9	0	-	=
  tab							[	]
  caps
  	lalt
)

(deflayer main
  _	_	_	_	_	_	_	_	_	_	_	_
  @tab							@lnav	@rnav
  @escr
  	_
)

(deflayer symbols
  S-1	S-2	S-3	S-4	S-5	S-6	S-7	S-8	S-9	S-0	S--	S-=
  _							_	_	
  caps
  	_
)

;; Variables
(defvar
	tap-timeout 200
	hold-timeout 200
)

;; Aliases
(defalias
	;; layer
	;; layer-main (layer-switch main)

	;; tap for esc, hold for left-ctrl
	escr (tap-hold-press $tap-timeout $hold-timeout esc lctl)
	
	;; tap for tab, hold for symbol layer
	tab (tap-hold-press $tap-timeout $hold-timeout tab (layer-toggle symbols))
	
	;; Windows Navigation
	lnav (tap-hold $tap-timeout $hold-timeout S-tab [)
	rnav (tap-hold $tap-timeout $hold-timeout tab ])

	;; add timeout to lalt
	;; lalt (one-shot-release 500 lalt)
)

#|
(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer nul
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv	1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab	q    w    e    r    t    y    u    i    o    p    [    ]   \ 
  @esctrl a  s    d    f    g    h    j    k    l    ;    '
  @lsft	z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer symbols
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0  _    _    _
  _    S-5  S-6  S-7  S-8  _    _    _    _    S-9  S-0  _    _    _
  _    _    _    del  _    _    left down up   rght _    _ 
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)
|#
