(defcfg
  process-unmapped-keys no
)

(defsrc
  1    2    3    4    5    6    7    8    9    0	-	=
  tab	[  ]
  caps
)

(deflayer main
  1    2    3    4    5    6    7    8    9    0	-	=
  @tab	@lnav  @rnav
  @esctrl
)

(deflayer symbols
  S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0	_	+
  tab	_  _
  caps
)

#|
(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer nul
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab  q    w    e    r    t    y    u    i    o    p    [    ]   \ 
  @esctrl a    s    d    f    g    h    j    k    l    ;    '
  @lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer symbols
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0  _    _    _
  _    S-5  S-6  S-7  S-8  _    _    _    _    S-9  S-0  _    _    _
  _    _    _    del  _    _    left down up   rght _    _ 
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)
|#

;; Aliases
(defalias
	;; layer
	layer-main (layer-switch main)
	;; layer-nav (layer-toggle symbols)
	
	;; tap for esc, hold for left-ctrl
	esctrl (tap-hold 200 200 esc lctl)
	
	;; add timeout to lsft
	;; lsft (one-shot-release 500 lsft)
	
	;; tap for tab, hold for symbol layer
	tab (tap-hold 200 200 tab (layer-toggle symbols))
	
	;; Windows Navigation
	lnav (tap-hold 200 200 S-tab [)
	rnav (tap-hold 200 200 tab ])
)