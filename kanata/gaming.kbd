(defcfg
  process-unmapped-keys no
  concurrent-tap-hold yes
)

(defsrc
  1	2	3	4	5	6	7	8	9	0	-	=
  tab
  caps
  lsft
  	lalt
)

(deflayer PRIMUS
  _	_	_	_	_	_	_	_	_	_	_	_
  @tab
  ctl
  @lsf
  	@lalt
)

(deflayer SECUNDUS
  S-1	S-2	S-3	S-4	S-5	S-6	S-7	S-8	S-9	S-0	S--	S-=
  _
  caps
  @lsf
  	@lalt
)

;; Variables
(defvar
	medium-timeout 200
	brief-timeout 100
)

(defvirtualkeys
	sft lsft
)

;; Aliases
(defalias
	;; tap for tab, hold for second layer
	tab (tap-hold-press $medium-timeout $medium-timeout tab (layer-toggle SECUNDUS))

	;; add timeout to lalt
	lalt (one-shot-release 500 lalt)

	lsf (on-press toggle-vkey sft)
)
